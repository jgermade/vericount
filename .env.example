# Settings for docker-compose.yml. Copy to .env and fill in.

# Passwords of the database owner (migrations) and of the server's role.
POSTGRES_PASSWORD=
VERICOUNTS_DB_PASSWORD=

# Where users open vericounts. Passkeys are bound to its host name.
VERICOUNTS_PUBLIC_URL=http://localhost:8080
VERICOUNTS_PORT=8080

# Mail for sign-in codes and invitations. Required in production.
VERICOUNTS_SMTP_URL=
VERICOUNTS_MAIL_FROM=

# AEAT: "test" or "production"; set VERICOUNTS_AEAT_SUBMIT=1 to send records.
VERICOUNTS_AEAT_ENV=test
VERICOUNTS_AEAT_SUBMIT=
VERICOUNTS_AEAT_IDENTITY_PEM=
VERICOUNTS_AEAT_REPRESENTATIVE_NAME=
VERICOUNTS_AEAT_REPRESENTATIVE_NIF=
VERICOUNTS_SOFTWARE_PRODUCER_NAME=
VERICOUNTS_SOFTWARE_PRODUCER_NIF=

# Another image or version, e.g. ghcr.io/jgermade/vericounts:0.2.0
# VERICOUNTS_IMAGE=
