# Settings for docker-compose.yml. Copy to .env and fill in.

# Passwords of the database owner (migrations) and of the server's role.
POSTGRES_PASSWORD=
VERICOUNT_DB_PASSWORD=

# Where users open vericount. Passkeys are bound to its host name.
VERICOUNT_PUBLIC_URL=http://localhost:8080
VERICOUNT_PORT=8080

# Mail for sign-in codes and invitations. Required in production.
VERICOUNT_SMTP_URL=
VERICOUNT_MAIL_FROM=

# Encrypts the AEAT certificate uploaded in the settings: 64 hexadecimal
# digits, from `openssl rand -hex 32`. Keep a copy with the database
# backups: the stored certificate cannot be read without it.
VERICOUNT_SECRET_KEY=

# vericount starts in practice mode: invoices are not real and records go
# to a mock inside the server. Live mode is turned on in the settings,
# after uploading the certificate. Where live records go: "test" (the AEAT
# pre-production service) or "production".
VERICOUNT_AEAT_ENV=test
VERICOUNT_AEAT_REPRESENTATIVE_NAME=
VERICOUNT_AEAT_REPRESENTATIVE_NIF=
VERICOUNT_SOFTWARE_PRODUCER_NAME=
VERICOUNT_SOFTWARE_PRODUCER_NIF=

# Another image or version, e.g. ghcr.io/jgermade/vericount:0.2.0
# VERICOUNT_IMAGE=
